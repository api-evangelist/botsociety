  "info": {
    "_postman_id": "2f288968-ea28-4797-b628-5fee7f202248",
    "name": "Botsociety Conversations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Botsociety API lets your application retrieve the content of chatbot and voice-assistant designs (conversations, messages, variables, intents) created in the Botsociety design tool, so message content can be updated in the design tool without redeploying bot code. Reconstructed from the official `botsociety` npm client (v4.0.1). Authentication uses a user id plus a public API key, both obtained from the Botsociety app and passed as request headers.\n\nContact Support:\n Name: Botsociety\n Email: info@botsociety.io",
      "type": "text/plain"
    }
  }
